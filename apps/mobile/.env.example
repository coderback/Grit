# Copy to .env and fill in. EXPO_PUBLIC_* values are inlined into the JS bundle — never put secrets here.

# Supabase — Dashboard → Settings → API (same project as the backend)
EXPO_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# GRIT backend base URL. localhost only works on iOS simulator / web;
# use http://10.0.2.2:3000 for Android emulator or your machine's LAN IP for a physical device.
EXPO_PUBLIC_API_URL=http://localhost:3000
