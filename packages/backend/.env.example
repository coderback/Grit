# Copy to .env and fill in. Variables marked (required) are read with getOrThrow and the app won't boot without them.

# PostgreSQL connection (Supabase — use Transaction Pooler URL for DATABASE_URL)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"  # (required)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"  # (required) used by prisma migrate

# Supabase — Dashboard → Settings → API
SUPABASE_URL="https://[project-ref].supabase.co"  # (required)
SUPABASE_ANON_KEY="eyJ..."  # (required) anon/public key
SUPABASE_SERVICE_KEY="eyJ..."  # Service role key — keep secret (not used by code yet)

# Azure AI Foundry (AI coach) — Foundry portal → your resource → Keys and Endpoint
AZURE_OPENAI_ENDPOINT="https://[resource].openai.azure.com"  # (required) /openai/v1 is appended automatically
AZURE_OPENAI_API_KEY="..."  # (required)
AZURE_OPENAI_DEPLOYMENT="gpt-6-luna"  # deployment name you chose in Foundry; defaults to gpt-6-luna

# Upstash Redis (not used by code yet)
UPSTASH_REDIS_URL="https://[your-instance].upstash.io"
UPSTASH_REDIS_TOKEN="..."

# App
PORT=3000
NODE_ENV=development
