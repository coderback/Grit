generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  supabaseId    String    @unique
  username      String    @unique
  displayName   String
  avatarUrl     String?
  calorieGoal   Int       @default(2000)
  weightKg      Float?
  primaryGoal   String    @default("just_track")
  heightCm      Float?
  activityLevel String?
  gender        String?
  dateOfBirth   DateTime?

  // Goal details from onboarding, editable in Goals & Targets
  goalWeightKg      Float?
  pace              String? // slow | moderate | aggressive
  goalFocus         String  @default("balanced") // high_protein | balanced | low_carb
  dietType          String? // none | vegetarian | vegan | halal_kosher
  aim               String? // fat_loss | muscle_gain | energy | discipline
  friction          String? // what gets in the way, for the coach
  activeMinutesGoal Int     @default(60)
  // Add today's burned calories to the budget / carry unused calories forward
  earnbackCalories  Boolean @default(false)
  rolloverCalories  Boolean @default(false)

  weightUnit String @default("kg") // kg | lb
  heightUnit String @default("cm") // cm | ft

  notifWorkout      Boolean @default(true)
  notifMeal         Boolean @default(false)
  notifProgress     Boolean @default(true)
  notifStreak       Boolean @default(true)
  notifOffTrackOnly Boolean @default(false)

  // Push and inbox alerts for follows, requests, kudos and challenges
  notifSocial Boolean @default(true)

  // Private accounts approve each follower; only approved followers see activity
  isPrivate Boolean @default(true)

  // Safety and consent (Phase 5). aiConsentAt: when the user agreed to
  // meal photos and chats going to Azure OpenAI (Apple 5.1.2(i)); null
  // means no AI features. edScreen: answer to the onboarding eating-disorder
  // question (no | yes | prefer_not); "yes" turns off weight-loss targets.
  aiConsentAt            DateTime?
  edScreen               String?
  // Separate, default-off permissions to use data beyond the app itself
  consentFoodData        Boolean   @default(false)
  consentHealthTraining  Boolean   @default(false)
  consentWorkoutTraining Boolean   @default(false)
  consentOffSharing      Boolean   @default(false)
  // Its own consent (Phase 6): reading menstrual data from the health app.
  // Turning it off deletes what was imported.
  consentCycleData       Boolean   @default(false)

  // Meal descriptions/photos read by the AI today (a daily cap)
  aiParseDay   String?
  aiParseCount Int     @default(0)

  // Adaptive targets: when a suggestion was last taken or put off
  adaptiveAppliedAt    DateTime?
  adaptiveSnoozedUntil DateTime?

  // The device's latest UTC offset in minutes, so scheduled alerts arrive at
  // the right local time
  utcOffset Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  foodLogs          FoodLog[]
  activityLogs      ActivityLog[]
  habitLogs         HabitLog[]
  habits            Habit[]
  following         Follow[]               @relation("following")
  followers         Follow[]               @relation("followers")
  challenges        ChallengeParticipant[]
  aiMessages        AIMessage[]
  searchEvents      SearchEvent[]
  coachMemories     CoachMemory[]
  kudosGiven        Kudos[]
  workoutPlan       WorkoutPlan?
  blocking          Block[]                @relation("blocker")
  blockedBy         Block[]                @relation("blocked")
  pushDevices       PushDevice[]
  weightLogs        WeightLog[]
  favoriteFoods     FavoriteFood[]
  healthDays        HealthDay[]
  healthMetrics     HealthMetric[]
  workoutSessions   WorkoutSession[]
  foodMemories      FoodMemory[]
  notifications     Notification[]         @relation("recipient")
  notificationsSent Notification[]         @relation("actor")

  @@map("users")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  // pending until a private account approves it
  status      String   @default("accepted") // pending | accepted
  createdAt   DateTime @default(now())

  follower  User @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, status])
  @@map("follows")
}

// A blocked user can't find, follow or see the blocker, and vice versa
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model FoodLog {
  id          String   @id @default(cuid())
  userId      String
  name        String
  brand       String?
  barcode     String?
  mealType    String
  calories    Float
  proteinG    Float    @default(0)
  carbsG      Float    @default(0)
  fatG        Float    @default(0)
  servingQty  Float    @default(1)
  servingUnit String   @default("serving")
  loggedAt    DateTime @default(now())
  caffeineMg  Float?
  alcoholG    Float?
  // Set when the user changed the numbers of a food they picked, which
  // measures how often the food data is wrong
  corrected   Boolean  @default(false)
  // The database food this came from, and how many grams were eaten
  foodId      String?
  grams       Float?
  // The eaten amount's nutrients when logged, e.g. { "iron_mg": { "amount":
  // 1.2, "basis": "measured" } }: a snapshot, so later fixes to the food
  // data don't change past days
  nutrients   Json?

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  food Food? @relation(fields: [foodId], references: [id], onDelete: SetNull)

  @@index([userId, loggedAt])
  @@index([foodId])
  @@map("food_logs")
}

model ActivityLog {
  id             String   @id @default(cuid())
  userId         String
  activityType   String
  durationMin    Int
  caloriesBurned Float?
  steps          Int?
  source         String   @default("manual")
  // light | moderate | vigorous, or a pace for running; picks the MET value
  intensity      String?
  loggedAt       DateTime @default(now())
  kudosCount     Int      @default(0)
  // The health app's ID for an imported workout, so importing again updates it
  externalId     String?
  // From the health app: the workout's average heart rate and distance
  avgHeartRate   Int?
  distanceM      Float?
  // How caloriesBurned was worked out: manual | device | heart_rate | met
  calorieMethod  String?

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kudos          Kudos[]
  // Set by set, for a strength session logged in GRIT
  workoutSession WorkoutSession?

  @@unique([userId, externalId])
  @@index([userId, loggedAt])
  @@map("activity_logs")
}

// One kudos per user per activity log; kudosCount on the log is the tally
model Kudos {
  id            String   @id @default(cuid())
  activityLogId String
  userId        String
  createdAt     DateTime @default(now())

  activityLog ActivityLog @relation(fields: [activityLogId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityLogId, userId])
  @@index([userId])
  @@map("kudos")
}

model Habit {
  id        String   @id @default(cuid())
  userId    String
  name      String
  emoji     String   @default("✅")
  isPreset  Boolean  @default(false)
  presetKey String?
  createdAt DateTime @default(now())
  isActive  Boolean  @default(true)

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  @@index([userId, isActive])
  @@map("habits")
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  userId    String
  completed Boolean  @default(true)
  // The local day checked off, stored as midnight UTC of that date
  loggedAt  DateTime @default(now())
  // When the check-in actually happened; the social feed orders by this
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, userId, loggedAt])
  @@index([userId, loggedAt])
  @@index([userId, createdAt])
  @@map("habit_logs")
}

model Challenge {
  id           String    @id @default(cuid())
  title        String
  // What counts, from workouts logged during the challenge:
  // steps | active_minutes | workouts
  type         String    @default("active_minutes")
  goalValue    Int
  durationDays Int
  startDate    DateTime
  endDate      DateTime
  creatorId    String
  inviteCode   String    @unique @default(cuid())
  // The group reached the goal (it can still be running)
  isComplete   Boolean   @default(false)
  // Set once the end date has passed and the results were sent
  endedAt      DateTime?
  createdAt    DateTime  @default(now())

  participants ChallengeParticipant[]

  // The hourly job looks for challenges past their end that haven't finished
  @@index([endedAt, endDate])
  @@map("challenges")
}

model ChallengeParticipant {
  id           String   @id @default(cuid())
  challengeId  String
  userId       String
  // Recomputed from the user's logged workouts in the challenge window
  currentValue Int      @default(0)
  joinedAt     DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([userId])
  @@map("challenge_participants")
}

model AIMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_messages")
}

// Lasting facts the coach has learned about the user (an injury, foods they
// avoid, when they train), from chats or added by hand. Shown and editable
// in settings.
model CoachMemory {
  id        String   @id @default(cuid())
  userId    String
  text      String
  // chat | user
  source    String   @default("chat")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("coach_memories")
}

// The coach-generated weekly plan; one per user, replaced when regenerated
model WorkoutPlan {
  id          String @id @default(cuid())
  userId      String @unique
  summary     String
  daysPerWeek Int
  location    String // home | gym
  days        Json // 7 days, Monday first: { day, rest, title, activityType, durationMin, exercises: [{ name, detail }] }

  // Caps how often the AI is asked to regenerate it
  generationDay    String // local YYYY-MM-DD of the latest generation
  generationsToday Int    @default(1)

  // The training session (1, 2, 3…) that comes next. Plans run in order, so
  // a missed day moves the week along instead of skipping a session.
  nextSession Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("workout_plans")
}

// One row per phone signed in to the account; Expo push tokens
model PushDevice {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String // ios | android
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_devices")
}

// The in-app inbox. Push alerts are sent for these too, if the user allows.
model Notification {
  id        String    @id @default(cuid())
  userId    String // who it's for
  // follow | follow_request | follow_accepted | kudos | challenge_joined |
  // challenge_ended | streak_at_risk | weekly_progress | coach_checkin
  type      String
  actorId   String? // who caused it, for social alerts
  title     String
  body      String
  data      Json      @default("{}") // ids to open: userId, challengeId, ...
  // Stops the same alert being sent twice, e.g. "streak:2026-11-04"
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user  User  @relation("recipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("actor", fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@map("notifications")
}

// One weigh-in per day; the latest also updates users.weightKg
model WeightLog {
  id        String   @id @default(cuid())
  userId    String
  weightKg  Float
  // The local day, stored as midnight UTC of that date (like habit check-ins)
  day       DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@map("weight_logs")
}

// A saved portion for one-tap re-logging: what was eaten, not per 100 g
model FavoriteFood {
  id          String   @id @default(cuid())
  userId      String
  // lowercased "name|brand", so the same food can't be saved twice
  key         String
  name        String
  brand       String?
  barcode     String?
  calories    Float
  proteinG    Float    @default(0)
  carbsG      Float    @default(0)
  fatG        Float    @default(0)
  servingQty  Float    @default(1)
  servingUnit String   @default("serving")
  createdAt   DateTime @default(now())
  // The database food and the portion's grams, when known, so re-logging
  // it keeps its nutrients
  foodId      String?
  grams       Float?

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  food Food? @relation(fields: [foodId], references: [id], onDelete: SetNull)

  @@unique([userId, key])
  @@map("favorite_foods")
}

// Daily totals read from Apple Health / Health Connect. Steps count toward
// step challenges; sleep is context for the coach.
model HealthDay {
  id           String   @id @default(cuid())
  userId       String
  // The local day, stored as midnight UTC of that date
  day          DateTime
  steps        Int?
  // Asleep time for the night ending on this day
  sleepMinutes Int?
  source       String // healthkit | health_connect
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@map("health_days")
}

// What someone actually ate when they confirmed an AI-read meal: their
// nutrition per 100 g and usual portion for a food, used before any
// estimate the next time they mention it
model FoodMemory {
  id              String   @id @default(cuid())
  userId          String
  // lowercased, single-spaced name
  key             String
  name            String
  kcalPer100g     Float
  proteinPer100g  Float
  carbsPer100g    Float
  fatPer100g      Float
  usualGrams      Float
  // Caffeine (mg) and alcohol (g) per 100 g, if known
  caffeinePer100g Float?
  alcoholPer100g  Float?
  uses            Int      @default(1)
  updatedAt       DateTime @updatedAt
  // The database food it was matched to, so later logs keep its nutrients
  foodId          String?

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  food Food? @relation(fields: [foodId], references: [id], onDelete: SetNull)

  @@unique([userId, key])
  @@map("food_memories")
}

// One food search and what the user picked from it, if anything. Measures
// first-search success and where searches miss, by country and language.
model SearchEvent {
  id          String   @id @default(cuid())
  userId      String
  query       String
  // The chosen result's position (0-based) and name, or null if none was picked
  position    Int?
  pickedName  String?
  country     String?
  lang        String?
  createdAt   DateTime @default(now())
  // search | barcode (a scan: query is the code, resultCount 0 or 1)
  kind        String   @default("search")
  resultCount Int?
  // The database food picked, when it came from GRIT's own food data
  pickedId    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("search_events")
}

// The exercise library, imported from free-exercise-db (public domain)
model Exercise {
  id           String   @id // free-exercise-db's id, e.g. "Barbell_Squat"
  name         String
  aliases      String[]
  primary      String[] // muscles
  secondary    String[]
  equipment    String[] // barbell | dumbbell | machine | cable | bodyweight | band | kettlebell | other
  mechanics    String? // compound | isolation
  level        String? // beginner | intermediate | expert
  category     String? // strength | stretching | plyometrics | cardio | ...
  // Movement pattern, so a swap keeps progression history
  pattern      String?
  // What the exercise loads, used to avoid it for an injury
  stresses     String[]
  instructions String?
  imageUrl     String?
  source       String   @default("free-exercise-db")

  @@index([name])
  @@map("exercises")
}

// One training session logged set by set (Phase 6). Finishing it creates the
// ActivityLog, so the feed, challenges, calories and streaks work unchanged;
// deleting that log deletes the session.
model WorkoutSession {
  id            String   @id @default(cuid())
  userId        String
  // Made on the phone, so an upload retried after being offline is saved once
  clientId      String
  activityLogId String   @unique
  // Which training session of the plan this was (1, 2, 3…), if any
  planSession   Int?
  title         String?
  startedAt     DateTime
  endedAt       DateTime
  // Summary for the feed and history
  setCount      Int      @default(0)
  volumeKg      Float    @default(0)
  prCount       Int      @default(0)
  createdAt     DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityLog ActivityLog  @relation(fields: [activityLogId], references: [id], onDelete: Cascade)
  sets        WorkoutSet[]

  @@unique([userId, clientId])
  @@index([userId, startedAt])
  @@map("workout_sessions")
}

model WorkoutSet {
  id          String  @id @default(cuid())
  sessionId   String
  // Copied from the session, for per-exercise history
  userId      String
  exerciseId  String
  order       Int
  reps        Int     @default(0)
  weightKg    Float? // null for bodyweight
  durationSec Int? // for timed sets: planks, intervals
  rpe         Float? // optional effort, 6–10
  warmup      Boolean @default(false)
  // Sets sharing one are a superset or circuit
  supersetId  String?
  // The record this set set when it was logged: e1rm | weight | reps
  pr          String?

  session WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId, exerciseId])
  @@map("workout_sets")
}

// Daily recovery and cycle values from Apple Health / Health Connect
// (Phase 6). Cycle data needs consentCycleData, and is never shown in the
// feed or challenges or written into coach memory.
model HealthMetric {
  id        String   @id @default(cuid())
  userId    String
  // The local day, stored as midnight UTC of that date
  day       DateTime
  // hrv | resting_hr | respiratory_rate | sleep_temp_deviation | vo2max | menstrual_flow
  metric    String
  // For HRV: sdnn (Apple) or rmssd (Health Connect), which can't be
  // compared; '' for everything else
  type      String   @default("")
  value     Float
  // ms | bpm | breaths_min | degC | ml_kg_min | level
  unit      String
  source    String // healthkit | health_connect
  // The app or device that recorded it, if the health app says
  device    String?
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day, metric, type])
  @@index([userId, metric, day])
  @@map("health_metrics")
}

// ── GRIT's food database (Phase 7) ───────────────────────────────────────────
// Shared by everyone and filled by the importers in packages/food-data, not
// by users. Nutrients are per 100 g, in the units listed in
// src/food/nutrients.ts.

// One food, however many products and sources describe it
model Food {
  id          String   @id @default(cuid())
  name        String
  brand       String?
  // generic | branded | dish | restaurant | user
  kind        String
  category    String?
  // As printed, for branded foods
  ingredients String?
  // Where it's sold or which national table lists it, e.g. ["gb", "us"]
  countries   String[]
  // 0–1: how complete and trustworthy the entry is
  quality     Float    @default(0)
  // How many times GRIT users have logged it
  popularity  Int      @default(0)
  // From a government table or a manufacturer's own data
  verified    Boolean  @default(false)
  // The source whose values are shown: fdc | off | cofid | cnf | ciqual | fineli
  source      String
  // Lowercased, accent-free name, brand and other names, for search
  searchText  String
  // The same, for foods always searched in full: generic foods and dishes,
  // and products GRIT users have logged or scanned. Null for the long tail
  // of products, which a search only samples (see FoodDbService.search)
  coreText    String?
  imageUrl    String?
  updatedAt   DateTime @updatedAt

  barcodes  FoodBarcode[]
  servings  FoodServing[]
  nutrients FoodNutrient[]
  names     FoodName[]
  sources   FoodSource[]
  logs      FoodLog[]
  memories  FoodMemory[]
  favorites FavoriteFood[]

  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([coreText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("foods")
}

model FoodBarcode {
  // Normalised to GTIN-13 (see food-data's barcode.ts)
  code   String @id
  foodId String
  food   Food   @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@index([foodId])
  @@map("food_barcodes")
}

// "1 slice = 28 g", "1 cup = 240 g"
model FoodServing {
  id      String  @id @default(cuid())
  foodId  String
  label   String
  grams   Float
  // The default portion
  typical Boolean @default(false)
  food    Food    @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([foodId, label])
  @@map("food_servings")
}

model FoodNutrient {
  foodId   String
  // A code from src/food/nutrients.ts, e.g. "iron_mg"
  nutrient String
  // Per 100 g
  amount   Float
  // measured | label | estimated
  basis    String
  // A range, for estimates (Phase 9)
  low      Float?
  high     Float?
  food     Food   @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@id([foodId, nutrient])
  @@map("food_nutrients")
}

// Local and alternative names, per language: "aubergine" (en-GB) for
// eggplant, "eba" (yo) for garri paste
model FoodName {
  id     String @id @default(cuid())
  foodId String
  name   String
  // BCP 47, e.g. "en-GB", "fr", "fi"
  lang   String
  food   Food   @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([foodId, lang, name])
  @@index([name])
  @@map("food_names")
}

// Where each food came from, so values can be traced, refreshed, or removed
// with their source
model FoodSource {
  id         String   @id @default(cuid())
  foodId     String
  // fdc | off | cofid | cnf | ciqual | fineli
  source     String
  externalId String
  // When the source last changed this row (its release date, or the
  // product's last edit), so re-importing the same data changes nothing
  fetchedAt  DateTime
  food       Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([foodId])
  @@map("food_sources")
}
